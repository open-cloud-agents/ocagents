{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./site/**)",
      "Read(./build_docs/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./ai_brain/**)",
      "Read(./mock/**)",
      "Read(./.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.secret)",
      "Read(./node_modules/**)",
      "Read(./.venv/**)",
      "Edit(./.env*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.secret)",
      "Bash(git push --force*)",
      "Bash(git push * -f*)",
      "Bash(rm -rf *)",
      "Bash(chmod 777*)"
    ]
  }
}
