dist/
build/
*.egg-info/
packaging/pyinstaller/dist/
packaging/pyinstaller/build/
Formula/*.tar.gz
Formula/*.zip
*.exe
*.bin
*.so
*.dylib
*.dll
*.pyc
*.pyo
*.pyd

# Virtual Environments & Package Managers
.venv/
venv/
env/
ENV/
node_modules/
__pycache__/
.dart_tool/
.packages

# Large Dependency Lockfiles
package-lock.json
yarn.lock
pnpm-lock.yaml
poetry.lock
Pipfile.lock
composer.lock
Cargo.lock

