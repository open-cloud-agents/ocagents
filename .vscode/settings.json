{
  "editor.unicodeHighlight.allowedCharacters": {
    "×": true,
    "–": true,
    "—": true,
    "•": true,
    "“": true,
    "”": true,
    "‘": true,
    "’": true,
    "…": true,
    "→": true,
    "←": true,
    "≈": true,
    "≤": true,
    "≥": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "site": true,
    "build_docs": true,
    "dist": true,
    "build": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    "ai_brain": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "site/**": true,
    "build_docs/**": true,
    "dist/**": true,
    "build/**": true,
    ".pytest_cache/**": true,
    ".ruff_cache/**": true,
    "ai_brain/**": true,
    "mock/**": true,
    "package-lock.json": true,
    "yarn.lock": true,
    "pnpm-lock.yaml": true,
    "poetry.lock": true,
    "Pipfile.lock": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.venv/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/site/**": true,
    "**/build_docs/**": true,
    "**/ai_brain/**": true
  },
  "yaml.customTags": [
    "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format",
    "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_div_format",
    "tag:yaml.org,2002:python/name:*"
  ]
}
