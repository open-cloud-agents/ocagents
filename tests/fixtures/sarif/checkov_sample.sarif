{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Checkov",
          "version": "3.2.14",
          "rules": [
            {
              "id": "CKV_AWS_20",
              "name": "S3BucketPublicAccessBlock",
              "shortDescription": {
                "text": "Ensure S3 bucket has an access block configuration."
              },
              "help": {
                "text": "Add aws_s3_bucket_public_access_block resource to ensure public access is blocked."
              },
              "properties": {
                "category": "Infrastructure as Code (IaC) Security",
                "severity": "HIGH"
              }
            },
            {
              "id": "CKV_AWS_1",
              "name": "S3BucketPreventDestroy",
              "shortDescription": {
                "text": "Ensure S3 bucket has force_destroy disabled."
              },
              "help": {
                "text": "Remove force_destroy = true from aws_s3_bucket to prevent catastrophic deletion."
              },
              "properties": {
                "category": "Zero Unplanned Destruction",
                "severity": "CRITICAL"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CKV_AWS_20",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "S3 Bucket Public Access Block configuration is missing."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "infra/s3.tf",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "endLine": 25,
                  "startColumn": 1,
                  "endColumn": 2
                }
              },
              "logicalLocations": [
                {
                  "name": "aws_s3_bucket.data_bucket",
                  "fullyQualifiedName": "module.storage.aws_s3_bucket.data_bucket",
                  "kind": "resource"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CKV_AWS_1",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "S3 bucket has force_destroy enabled."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "infra/s3.tf"
                },
                "region": {
                  "startLine": 28,
                  "endLine": 35
                }
              },
              "logicalLocations": [
                {
                  "name": "aws_s3_bucket.ephemeral_bucket"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
